{
  "name": "@Rcode/rcode-cli",
  "version": "0.1.0",
  "description": "Rcode CLI — terminal coding agent over the existing Rcode HTTP/SSE runtime",
  "type": "module",
  "bin": {
    "rcode": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --root .",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vitest": "^4.1.7"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
